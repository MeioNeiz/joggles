# Python
.venv/
__pycache__/
*.pyc

# Pulled/derived vendor artefacts - large, and not ours to redistribute
apk/
decompiled/
native/

# HCI snoop logs and other captures: can contain other devices' traffic
captures/
*.log
*.pcap
*.pcapng

.DS_Store
firmware/

# Per-device flash-wear counts. Local to this host, and exportable rather than shared.
.joggles/

# animpack's downloaded source archives: open-licence, but not ours to redistribute in
# git. Only the converted data file and the licence manifest are checked in.
research/animpack-sources/

# Bun installs these; noble is rebuilt locally via trustedDependencies (see README)
node_modules/

# Live agent coordination state for this machine; the convention is in the README
.claude/locks/*
!.claude/locks/README

# A tool called with no output path once wrote two 76,800-byte vendor firmware windows
# here (2026-08-20, found by track 70). They were byte-identical to the donor's
# application region and carried TR1906R04-12, so committing them would have broken the
# "no vendor binaries" rule via a path nobody was watching. Ignored so a recurrence
# cannot be staged; the real fix is the caller that resolved its output to `undefined`.
undefined/
